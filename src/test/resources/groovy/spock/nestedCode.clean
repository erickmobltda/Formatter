class ServiceSpec extends Specification {

    def "should process items conditionally"() {
        given:
            def items = [1, 2, 3, 4, 5]
            def threshold = 3

        when:
            def result = []
            for (item in items) {
                if (item > threshold) {
                    result.add(item)
                }
            }

        then:
            result == [4, 5]
            result.size() == 2
    }
}
